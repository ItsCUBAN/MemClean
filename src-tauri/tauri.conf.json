{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemClean",
  "version": "0.2.0",
  "identifier": "com.memclean.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MemClean",
    "copyright": "© 2026 MemClean",
    "category": "Utility",
    "shortDescription": "Limpiador de RAM para la bandeja del sistema",
    "longDescription": "MemClean vigila la memoria RAM desde la bandeja del sistema y la libera manual o automáticamente, sin cerrar ningún programa.",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
